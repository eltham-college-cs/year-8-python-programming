---
import BaseLayout from '../layouts/BaseLayout.astro';
import { keywords, termSlug, findKeyword } from '../data/keywords';
import { getLessons, lessonUrl } from '../lib/lessons';

const lessons = await getLessons();
const usedIn = new Map<string, { title: string; href: string }[]>();
for (const l of lessons) {
  for (const w of l.data.keywords) {
    const k = findKeyword(w);
    if (!k) continue;
    const list = usedIn.get(k.term) ?? [];
    if (!list.some((x) => x.href === lessonUrl(l))) list.push({ title: l.data.title, href: lessonUrl(l) });
    usedIn.set(k.term, list);
  }
}
const sorted = [...keywords].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
---

<BaseLayout title="Key words" description="Python words for Year 8, explained simply.">
  <section class="hero">
    <div class="hero-text">
      <span class="eyebrow">Year 8 · Reference</span>
      <h1>Key words</h1>
      <p class="summary">Every word you meet in the lessons, in plain English.</p>
    </div>
  </section>

  <div class="glossary">
    {
      sorted.map((k) => (
        <div class="entry" id={termSlug(k.term)}>

          <h2 class="dt">{k.term}</h2>
          <p>{k.meaning}</p>
          {k.example && (
            <p>
              <code>{k.example}</code>
            </p>
          )}
          {usedIn.get(k.term) && (
            <p class="muted" style="font-size:16px">
              In:{' '}
              {usedIn.get(k.term)!.map((u, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={u.href}>
                    {u.title}
                  </a>
                </>
              ))}
            </p>
          )}
        </div>
      ))
    }
  </div>
</BaseLayout>
